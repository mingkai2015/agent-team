# Environment variables template
# Copy this file to .env and fill in your actual values

# Database
DATABASE_URL=postgresql://agentteam:yourpassword@postgres:5432/agentteam
REDIS_URL=redis://redis:6379

# Anthropic LLM Configuration
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_AUTH_TOKEN=sk-ant-your-api-key-here
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# GitLab Configuration
GITLAB_MODE=mock
GITLAB_URL=https://gitlab.com
GITLAB_TOKEN=glpat-your-token-here
GITLAB_PROJECT_ID=your-namespace/your-project
GITLAB_REPO_URL=https://gitlab.com/your-namespace/your-project

# Optional: API key for auth middleware
API_KEY=
